{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "package": {
    "productName": "Talea IDE",
    "version": "0.1.0"
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src"
  },
  "tauri": {
    "windows": [
      {
        "title": "Talea IDE",
        "width": 800,
        "height": 600
      }
    ],
    "bundle": {
      "identifier": "com.talea.ide"
    },
    "allowlist": {
      "dialog": {
        "open": true,
        "save": true
      },
      "fs": {
        "readFile": true,
        "writeFile": true
      }
    }
  }
}

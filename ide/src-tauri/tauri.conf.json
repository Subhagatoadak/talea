{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.talea.ide",
  "productName": "Talea IDE",
  "version": "0.1.0",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talea IDE",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "fs:read-files",
            "fs:write-files"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true
  }
}
